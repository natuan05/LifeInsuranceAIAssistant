# Copy to .env at the repository root. Compose reads this file automatically.
# .env is private and Git ignored. Never paste docker compose config output in logs.
# Host ports (container ports and database role names remain internal constants).
GATEWAY_PORT=8080
SWAGGER_PORT=8081
DATABASE_UI_PORT=5050
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Core and Web. Empty origins/URLs below are derived from the configured ports.
CORE_ENABLE_API_DOCS=true
CORE_CORS_ORIGINS=
NEXT_PUBLIC_CORE_API_URL=/api/v1
NEXT_PUBLIC_DATABASE_UI_URL=

# Local object storage. Browser URL must be reachable from the host browser.
MINIO_REGION=ap-southeast-1
MINIO_BUCKET=life-insurance-documents
MINIO_BROWSER_REDIRECT_URL=
MINIO_CORS_ORIGINS=
MINIO_PUBLIC_ENDPOINT=
STORAGE_URL_TTL_SECONDS=900

# Public synthetic credentials for LOCAL development only, approved for team setup.
# Never use these defaults for cloud or real data. Blank = generate once instead.
# DB credentials are 16-128 characters.
# Existing volumes must match supplied values; changing .env does not rotate them.
# Quote values containing #, spaces or $ with single quotes in your private .env.
DB_BOOTSTRAP_PASSWORD=LocalDbOwner-2026!
DB_MIGRATION_PASSWORD=LocalDbMigrate-2026!
DB_CORE_PASSWORD=LocalDbCore-2026!
DB_ADMIN_PASSWORD=LocalDbAdmin-2026!
DB_VIEWER_PASSWORD=LocalDbViewer-2026!

# Optional initial MinIO credentials. Supply both fields for each identity or leave both blank.
# Access keys: 3-20 letters/digits/_/-. Secret keys: 8-128 characters.
# Existing credential volumes must match; never share these values with Web.
MINIO_ROOT_USER=local-storage-admin
MINIO_ROOT_PASSWORD=LocalMinioAdmin-2026!
MINIO_READER_ACCESS_KEY=local-reader
MINIO_READER_SECRET_KEY=LocalMinioReader-2026!
MINIO_WRITER_ACCESS_KEY=local-writer
MINIO_WRITER_SECRET_KEY=LocalMinioWriter-2026!
