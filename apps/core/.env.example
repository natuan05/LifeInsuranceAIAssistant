# Optional local settings. Defaults work without a .env file.
HOST=127.0.0.1
PORT=4000
# Local/test only. Production defaults to false and refuses true.
# NODE_ENV=development
# ENABLE_API_DOCS=true
# Exact frontend origins, separated by commas. Never use * with credentials.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Docker Compose supplies the following automatically. Host dev may configure
# its own core_runtime credential file; never use the bootstrap/superuser role.
# Recommended automatic host DB workflow from repo root: npm run dev:db
# It supplies PG settings at launch without rewriting this file.
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=life_insurance
# PGUSER=core_runtime
# DATABASE_PASSWORD_FILE=<absolute-path-to-private-runtime-password-file>
