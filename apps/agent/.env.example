# Copy to apps/agent/.env (Git ignored). Never commit or paste real values.
# Gemini API key for the approved trial configuration (evaluation/trial-config.json).
GEMINI_API_KEY=
# Offline indexer: write rag only. Used by `python -m life_agent.corpus --index`, never by the Agent runtime.
LIFE_AGENT_RAG_INDEXER_DSN=host=127.0.0.1 port=5432 dbname=life_insurance user=rag_indexer password=LocalDbRagIndexer-2026!
# Retrieval runtime: read-only on rag.
LIFE_AGENT_RAG_RETRIEVER_DSN=host=127.0.0.1 port=5432 dbname=life_insurance user=rag_retriever password=LocalDbRagRetriever-2026!
# Durable runtime store: migrations (agent_migrator) and runtime (agent_runtime, own pool).
LIFE_AGENT_STORE_MIGRATOR_DSN=host=127.0.0.1 port=5432 dbname=life_insurance user=agent_migrator password=LocalDbAgentMigrate-2026!
LIFE_AGENT_STORE_DSN=host=127.0.0.1 port=5432 dbname=life_insurance user=agent_runtime password=LocalDbAgentRuntime-2026!
# Optional: DB tests (tests/test_retrieval_db.py) insert and remove synthetic fixture rows only.
LIFE_AGENT_TEST_RAG_INDEXER_DSN=
LIFE_AGENT_TEST_RAG_RETRIEVER_DSN=
# Store tests (tests/test_store.py) use the runtime role; the admin DSN (local_owner) is only for the split/restore test.
LIFE_AGENT_TEST_STORE_DSN=
LIFE_AGENT_TEST_STORE_MIGRATOR_DSN=
LIFE_AGENT_TEST_ADMIN_DSN=
# --- Agent HTTP service (Task 6): `python -m life_agent.http serve`
# Runtime configuration file (agent/generation/embedding/search sections; the trial file is a trial, not a default).
LIFE_AGENT_RUNTIME_CONFIG=evaluation/trial-config.json
LIFE_AGENT_HTTP_HOST=127.0.0.1
LIFE_AGENT_HTTP_PORT=8090
# Core base URL for callbacks and internal reads (configuration only, never from a model, document or request body).
LIFE_AGENT_CORE_BASE_URL=http://127.0.0.1:3000
# LI-HMAC-SHA256-v1 keys, one keyring per direction, each key >= 32 random bytes as base64url:
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).rstrip(b'=').decode())"
# KEYS = "id:key[,old-id:old-key]"; KEY_ID signs (Agent -> Core) or is the current id (Core -> Agent). Same values on Core.
LIFE_AGENT_CORE_TO_AGENT_KEY_ID=
LIFE_AGENT_CORE_TO_AGENT_KEYS=
LIFE_AGENT_AGENT_TO_CORE_KEY_ID=
LIFE_AGENT_AGENT_TO_CORE_KEYS=
# Callback resend schedule (proposal in contracts 12.10, not decided): backoff 1 -> 60 s with jitter, give up after 24 h.
LIFE_AGENT_DELIVERY_INITIAL_S=1
LIFE_AGENT_DELIVERY_MAX_S=60
LIFE_AGENT_DELIVERY_JITTER=0.2
LIFE_AGENT_DELIVERY_MAX_AGE_S=86400
# Execution lease (s). Not renewed during a run, so keep it above the run deadline sent by Core.
LIFE_AGENT_LEASE_S=180
