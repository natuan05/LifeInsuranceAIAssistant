{
  "name": "life-insurance-ai-assistant",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.16.0 <12"
  },
  "workspaces": [
    "apps/core",
    "apps/web"
  ],
  "scripts": {
    "bootstrap:dev": "node scripts/local-tools.mjs bootstrap",
    "test:accounts": "node scripts/local-tools.mjs test-accounts",
    "test:auth": "node scripts/local-tools.mjs test-auth",
    "test:customers": "node scripts/local-tools.mjs test-customers",
    "test:policies": "node scripts/local-tools.mjs test-policies",
    "test:policy-seed": "node scripts/local-tools.mjs test-policy-seed",
    "admin:setup": "node scripts/local-tools.mjs admin-setup",
    "admin": "node scripts/local-tools.mjs admin",
    "test:admin": "node scripts/local-tools.mjs test-admin",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check:connection": "node scripts/check-connection.mjs",
    "db:setup": "node scripts/postgres.mjs setup",
    "db:up": "node scripts/postgres.mjs up",
    "db:ui": "node scripts/postgres.mjs ui",
    "db:check": "node scripts/postgres.mjs check",
    "db:status": "node scripts/postgres.mjs status",
    "db:down": "node scripts/postgres.mjs down",
    "db:psql": "docker compose exec postgres psql -X -U local_owner -d life_insurance",
    "local:up": "node scripts/postgres.mjs up",
    "local:check": "node scripts/postgres.mjs check",
    "local:down": "node scripts/postgres.mjs down",
    "storage:up": "node scripts/storage.mjs up",
    "storage:check": "node scripts/storage.mjs check",
    "storage:credentials": "node scripts/storage.mjs credentials"
  },
  "devDependencies": {},
  "overrides": {
    "multer": "2.5.0"
  }
}
